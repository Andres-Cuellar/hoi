---
import PageShell from '../components/PageShell.astro';
import { studs } from '../data/studs';
---

<PageShell title="Contact — HOI STUDS" current="/contact" lightHeader>
  <section class="contact-page-hero"><p class="section-kicker mono">START THE CONVERSATION</p><h1 class="display">LET'S BUILD THE<br /><em>NEXT GENERATION.</em></h1><p>Tell us about your female, your breeding goals and the genetics you are looking for.</p></section>
  <section class="contact-form-shell section-shell" data-reveal><div><p class="section-kicker mono">BOOK A CONSULTATION</p><h2 class="display">Find the right<br />genetic match.</h2><p>Our team will help you understand the options and choose the next step for your program.</p></div><form class="contact-form" action="mailto:hello@hoistuds.com" method="post" enctype="text/plain"><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label><label>WhatsApp<input name="whatsapp" /></label><label>Female's name<input name="female" /></label><label>Which stud are you interested in?<select name="stud" class="stud-select"><option value="">Not sure yet — please advise</option>{studs.map((s) => <option value={s.slug}>{s.name} — {s.tags.join(', ')}</option>)}</select></label><label>What are you looking for?<select name="interest"><option>Stud Service</option><option>Lock-In</option><option>Genetic Consultation</option><option>Shipping</option></select></label><label>Tell us about your goals<textarea name="message" rows="4"></textarea></label><button class="button button--primary" type="submit">TALK TO OUR TEAM ↗</button></form></section>
</PageShell>
